# Elastic Beanstalk Configuration
# This file contains example configuration for deploying Flask to EB

# Environment Configuration
# ========================

# Application Name: flask-api
# Environment Name: flask-api-env
# Platform: Python 3.9 running on 64bit Amazon Linux 2
# Instance Type: t2.micro (Free Tier eligible)

# EB CLI Initialization Commands
# ===============================

# Initialize EB application:
# eb init -p python-3.9 flask-api --region us-east-1

# Create EB environment:
# eb create flask-api-env --instance-type t2.micro

# Deploy application:
# eb deploy

# Open application in browser:
# eb open

# Check environment status:
# eb status

# View logs:
# eb logs

# SSH into instance:
# eb ssh

# Terminate environment:
# eb terminate flask-api-env


# Environment Properties
# ======================
# These can be set via EB console or CLI:

# FLASK_ENV=production
# FLASK_APP=application.py
# LOG_LEVEL=INFO


# Auto Scaling Configuration
# ===========================
# Min instances: 1
# Max instances: 4
# Scaling trigger: CPU > 70% for 5 minutes


# Load Balancer Configuration
# ============================
# Type: Application Load Balancer
# Health check path: /health
# Health check interval: 30 seconds
# Healthy threshold: 2
# Unhealthy threshold: 5


# Monitoring and Alarms
# =====================
# CloudWatch metrics enabled by default:
# - CPU Utilization
# - Network In/Out
# - Request Count
# - HTTP 4xx/5xx errors
# - Latency


# Rolling Updates Configuration
# ==============================
# Deployment policy: Rolling
# Batch size: 30%
# This ensures zero-downtime deployments


# Security Configuration
# ======================
# Security group: Allows HTTP (80) and HTTPS (443)
# IAM instance profile: aws-elasticbeanstalk-ec2-role
# Service role: aws-elasticbeanstalk-service-role
