{
  "rules": [
    {
      "rule-type": "selection",
      "rule-id": "1",
      "rule-name": "include-all-tables",
      "object-locator": {
        "schema-name": "mydb",
        "table-name": "%"
      },
      "rule-action": "include"
    },
    {
      "rule-type": "transformation",
      "rule-id": "2",
      "rule-name": "rename-schema",
      "rule-target": "schema",
      "object-locator": {
        "schema-name": "mydb"
      },
      "rule-action": "rename",
      "value": "mydb_migrated"
    },
    {
      "rule-type": "transformation",
      "rule-id": "3",
      "rule-name": "add-column",
      "rule-target": "column",
      "object-locator": {
        "schema-name": "mydb",
        "table-name": "%"
      },
      "rule-action": "add-column",
      "value": "migration_timestamp",
      "expression": "$AR_H_TIMESTAMP",
      "data-type": {
        "type": "datetime"
      }
    }
  ]
}
