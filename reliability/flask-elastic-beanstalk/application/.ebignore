# Elastic Beanstalk ignore file
# Files and directories listed here will be excluded from deployment

# Virtual environment directories
venv/
env/
ENV/
.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Environment variables (never deploy secrets!)
.env
.env.local
*.pem
*.key

# Git
.git/
.gitignore

# Documentation
README.md
docs/
