# Apache SSL/TLS Configuration Snippet for WordPress
# Add these configurations to /etc/httpd/conf.d/ssl.conf or create a separate
# SSL configuration file

# ============================================================================
# Virtual Host Configuration for HTTPS (Port 443)
# ============================================================================

<VirtualHost *:443>
    # Server identification
    ServerAdmin admin@example.com
    ServerName wordpress.local
    ServerAlias www.wordpress.local
    
    # Document root - WordPress installation directory
    DocumentRoot /var/www/html
    
    # Enable SSL/TLS
    SSLEngine on
    
    # SSL Certificate files
    # Update these paths to match your certificate locations
    SSLCertificateFile /etc/pki/tls/certs/wordpress.crt
    SSLCertificateKeyFile /etc/pki/tls/private/wordpress.key
    
    # Optional: SSL Certificate Chain file (for CA-signed certificates)
    # SSLCertificateChainFile /etc/pki/tls/certs/ca-bundle.crt
    
    # Directory permissions and options
    <Directory /var/www/html>
        # Allow .htaccess overrides for WordPress permalinks
        AllowOverride All
        
        # Access control
        Require all granted
        
        # Directory index files
        DirectoryIndex index.php index.html
        
        # Enable FollowSymLinks for WordPress
        Options FollowSymLinks
    </Directory>
    
    # Logging
    ErrorLog /var/log/httpd/wordpress_ssl_error.log
    CustomLog /var/log/httpd/wordpress_ssl_access.log combined
    
    # PHP configuration
    <FilesMatch \.php$>
        SetHandler "proxy:unix:/run/php-fpm/www.sock|fcgi://localhost"
    </FilesMatch>
</VirtualHost>

# ============================================================================
# SSL/TLS Protocol and Cipher Configuration
# ============================================================================

# Disable insecure SSL/TLS versions
# Only allow TLS 1.2 and TLS 1.3
SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1

# Strong cipher suite configuration
# Prioritize forward secrecy and strong encryption
SSLCipherSuite HIGH:!aNULL:!MD5:!3DES:!CAMELLIA:!AES128

# Honor server cipher order preference
SSLHonorCipherOrder on

# Enable SSL compression (disabled for BREACH attack mitigation)
SSLCompression off

# Enable OCSP Stapling for better SSL performance
# Requires Apache 2.4+
SSLUseStapling on
SSLStaplingCache "shmcb:logs/ssl_stapling(32768)"

# ============================================================================
# Security Headers for HTTPS
# ============================================================================

<IfModule mod_headers.c>
    # HTTP Strict Transport Security (HSTS)
    # Force browsers to use HTTPS for 1 year
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent clickjacking attacks
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (CSP)
    # Uncomment and customize for your WordPress site
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';"
</IfModule>

# ============================================================================
# HTTP to HTTPS Redirect
# ============================================================================

# Redirect all HTTP traffic to HTTPS
<VirtualHost *:80>
    ServerName wordpress.local
    ServerAlias www.wordpress.local
    
    # Redirect to HTTPS
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]
    
    # Alternative redirect method
    # Redirect permanent / https://wordpress.local/
</VirtualHost>

# ============================================================================
# SSL Session Configuration
# ============================================================================

# SSL session cache for better performance
SSLSessionCache "shmcb:/var/cache/mod_ssl/scache(512000)"
SSLSessionCacheTimeout 300

# ============================================================================
# Modern SSL/TLS Configuration (Recommended)
# ============================================================================

# For maximum security, use this configuration
# Note: May not be compatible with older browsers

# SSLProtocol -all +TLSv1.3 +TLSv1.2
# SSLCipherSuite TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256
# SSLHonorCipherOrder off
# SSLSessionTickets off

# ============================================================================
# Intermediate SSL/TLS Configuration (Balanced)
# ============================================================================

# For compatibility with most browsers while maintaining good security
# This is the default configuration used above

# SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
# SSLCipherSuite HIGH:!aNULL:!MD5:!3DES
# SSLHonorCipherOrder on

# ============================================================================
# Old SSL/TLS Configuration (Maximum Compatibility)
# ============================================================================

# Only use if you need to support very old browsers
# Not recommended for production

# SSLProtocol all -SSLv3
# SSLCipherSuite HIGH:MEDIUM:!aNULL:!MD5
# SSLHonorCipherOrder on

# ============================================================================
# Certificate Generation Commands
# ============================================================================

# Self-Signed Certificate (Testing Only):
# sudo openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#   -keyout /etc/pki/tls/private/wordpress.key \
#   -out /etc/pki/tls/certs/wordpress.crt \
#   -subj "/C=US/ST=State/L=City/O=Organization/OU=IT/CN=wordpress.local"

# Let's Encrypt Certificate (Production):
# sudo dnf install certbot python3-certbot-apache
# sudo certbot --apache -d wordpress.local -d www.wordpress.local

# AWS Certificate Manager (ACM):
# For production with AWS Load Balancer, use ACM certificates
# Configure SSL termination at the load balancer level

# ============================================================================
# Testing SSL Configuration
# ============================================================================

# Test Apache configuration:
# sudo apachectl configtest

# Test SSL certificate:
# openssl s_client -connect wordpress.local:443 -servername wordpress.local

# Check SSL certificate details:
# openssl x509 -in /etc/pki/tls/certs/wordpress.crt -text -noout

# Test SSL configuration online:
# https://www.ssllabs.com/ssltest/

# ============================================================================
# Notes for Implementation
# ============================================================================

# 1. Update certificate paths to match your actual certificate locations
# 2. Update ServerName and ServerAlias with your actual domain
# 3. For production, use CA-signed certificates (Let's Encrypt or commercial CA)
# 4. Consider using AWS Certificate Manager (ACM) with Application Load Balancer
# 5. Test SSL configuration with SSL Labs (https://www.ssllabs.com/ssltest/)
# 6. Enable HSTS only after confirming HTTPS works correctly
# 7. Monitor SSL certificate expiration and set up auto-renewal
# 8. Keep Apache and OpenSSL updated for security patches
