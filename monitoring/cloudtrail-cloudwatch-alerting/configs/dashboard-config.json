{
  "dashboardName": "SecurityMonitoring",
  "dashboardBody": {
    "widgets": [
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/Authentication",
              "FailedLoginAttempts",
              {
                "stat": "Sum",
                "label": "Failed Login Attempts"
              }
            ]
          ],
          "view": "timeSeries",
          "stacked": false,
          "region": "us-east-1",
          "title": "Failed Console Login Attempts (Last 24 Hours)",
          "period": 300,
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/Authentication",
              "FailedLoginAttempts",
              {
                "stat": "Sum"
              }
            ]
          ],
          "view": "singleValue",
          "region": "us-east-1",
          "title": "Total Failed Logins (24h)",
          "period": 86400
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/Authentication",
              "RootAccountUsage",
              {
                "stat": "Sum",
                "label": "Root Account Usage"
              }
            ]
          ],
          "view": "singleValue",
          "region": "us-east-1",
          "title": "Root Account Activity (24h)",
          "period": 86400
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/Authorization",
              "UnauthorizedAPICalls",
              {
                "stat": "Sum",
                "label": "Unauthorized API Calls"
              }
            ]
          ],
          "view": "timeSeries",
          "stacked": false,
          "region": "us-east-1",
          "title": "Unauthorized API Call Attempts",
          "period": 300,
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/IAM",
              "IAMPolicyChanges",
              {
                "stat": "Sum",
                "label": "IAM Policy Changes"
              }
            ],
            [
              "Security/Network",
              "SecurityGroupChanges",
              {
                "stat": "Sum",
                "label": "Security Group Changes"
              }
            ],
            [
              "Security/Network",
              "NetworkACLChanges",
              {
                "stat": "Sum",
                "label": "Network ACL Changes"
              }
            ]
          ],
          "view": "timeSeries",
          "stacked": false,
          "region": "us-east-1",
          "title": "Configuration Changes",
          "period": 300,
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "log",
        "properties": {
          "query": "SOURCE 'CloudTrail/SecurityLogs'\n| fields @timestamp, userIdentity.userName, sourceIPAddress, errorMessage\n| filter eventName = \"ConsoleLogin\" and errorMessage = \"Failed authentication\"\n| sort @timestamp desc\n| limit 20",
          "region": "us-east-1",
          "title": "Recent Failed Login Attempts",
          "stacked": false
        }
      },
      {
        "type": "log",
        "properties": {
          "query": "SOURCE 'CloudTrail/SecurityLogs'\n| fields @timestamp, userIdentity.userName, eventName, eventSource\n| filter userIdentity.type = \"Root\"\n| sort @timestamp desc\n| limit 10",
          "region": "us-east-1",
          "title": "Root Account Activity",
          "stacked": false
        }
      },
      {
        "type": "log",
        "properties": {
          "query": "SOURCE 'CloudTrail/SecurityLogs'\n| fields @timestamp, userIdentity.userName, eventName, errorCode\n| filter errorCode = \"AccessDenied\" or errorCode = \"UnauthorizedOperation\"\n| stats count() as DeniedAttempts by userIdentity.userName\n| sort DeniedAttempts desc\n| limit 10",
          "region": "us-east-1",
          "title": "Top Users with Access Denied Errors",
          "stacked": false
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/Audit",
              "CloudTrailChanges",
              {
                "stat": "Sum",
                "label": "CloudTrail Changes"
              }
            ]
          ],
          "view": "singleValue",
          "region": "us-east-1",
          "title": "CloudTrail Configuration Changes (24h)",
          "period": 86400
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/Storage",
              "S3BucketPolicyChanges",
              {
                "stat": "Sum",
                "label": "S3 Policy Changes"
              }
            ]
          ],
          "view": "timeSeries",
          "stacked": false,
          "region": "us-east-1",
          "title": "S3 Bucket Policy Changes",
          "period": 300,
          "yAxis": {
            "left": {
              "min": 0
            }
          }
        }
      },
      {
        "type": "log",
        "properties": {
          "query": "SOURCE 'CloudTrail/SecurityLogs'\n| fields eventSource\n| stats count() as APICallCount by eventSource\n| sort APICallCount desc\n| limit 10",
          "region": "us-east-1",
          "title": "Top 10 AWS Services by API Call Volume",
          "stacked": false
        }
      },
      {
        "type": "metric",
        "properties": {
          "metrics": [
            [
              "Security/Authentication",
              "ConsoleLoginWithoutMFA",
              {
                "stat": "Sum",
                "label": "Logins Without MFA"
              }
            ]
          ],
          "view": "singleValue",
          "region": "us-east-1",
          "title": "Console Logins Without MFA (24h)",
          "period": 86400
        }
      }
    ]
  },
  "notes": {
    "dashboardCreation": "Use AWS CLI or Console to create dashboard with this configuration",
    "widgetTypes": [
      "metric: Display CloudWatch metrics as line graphs, stacked areas, or single values",
      "log: Display CloudWatch Logs Insights query results",
      "text: Add markdown-formatted text for documentation",
      "alarm: Display alarm status widgets"
    ],
    "customization": [
      "Adjust time ranges for each widget independently",
      "Change colors and labels for better visualization",
      "Add annotations for important events",
      "Configure auto-refresh intervals"
    ]
  },
  "cliCommands": {
    "createDashboard": "aws cloudwatch put-dashboard --dashboard-name SecurityMonitoring --dashboard-body file://dashboard-config.json",
    "getDashboard": "aws cloudwatch get-dashboard --dashboard-name SecurityMonitoring",
    "listDashboards": "aws cloudwatch list-dashboards",
    "deleteDashboard": "aws cloudwatch delete-dashboards --dashboard-names SecurityMonitoring"
  },
  "bestPractices": [
    "Organize widgets logically (authentication, authorization, configuration changes)",
    "Use consistent time ranges across related widgets",
    "Include both metric and log widgets for comprehensive visibility",
    "Add text widgets to document response procedures",
    "Share dashboards with security and operations teams",
    "Set up dashboard auto-refresh for NOC/SOC displays",
    "Create separate dashboards for different audiences (executive, technical, compliance)"
  ],
  "refreshIntervals": {
    "realTime": "1 minute (for active incident response)",
    "monitoring": "5 minutes (for general monitoring)",
    "reporting": "1 hour (for executive dashboards)"
  }
}
