# Systemd Service Unit for Flask Application
# Place this file in /etc/systemd/system/flaskapp.service

[Unit]
Description=Flask Application with Gunicorn
After=network.target

[Service]
Type=notify
User=apache
Group=apache
RuntimeDirectory=gunicorn
WorkingDirectory=/var/www/flaskapp
Environment="PATH=/var/www/flaskapp/venv/bin"
ExecStart=/var/www/flaskapp/venv/bin/gunicorn \
    --config /var/www/flaskapp/gunicorn_config.py \
    --bind 0.0.0.0:8000 \
    wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
